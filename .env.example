# SE Assistant environment configuration.
# Copy this file to `.env` and adjust. Never commit a real `.env`.
# All variables are optional in v1 (the app is client-only, no secrets).

# Log verbosity for the structured logger.
# One of: trace | debug | info | warn | error | fatal
# Defaults to `debug` in dev and `info` in production when unset.
VITE_LOG_LEVEL=debug
